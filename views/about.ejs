            <td>REST JSON</td>
          </tr>
          <tr>
            <td><span class="badge-method post">POST</span></td>
            <td><code>/api/students</code></td>
            <td><code>apiRoutes.js</code></td>
            <td>Validates and creates student from JSON body</td>
            <td>REST JSON</td>
          </tr>
          <tr>
            <td><span class="badge-method put">PUT</span></td>
            <td><code>/api/students/:id</code></td>
            <td><code>apiRoutes.js</code></td>
            <td>Validates and updates student from JSON body</td>
            <td>REST JSON</td>
          </tr>
          <tr>
            <td><span class="badge-method delete">DELETE</span></td>
            <td><code>/api/students/:id</code></td>
            <td><code>apiRoutes.js</code></td>
            <td>Deletes student record via REST API</td>
            <td>REST JSON</td>
          </tr>
          <tr>
            <td><span class="badge-method get">GET</span></td>
            <td><code>/api/stats</code></td>
            <td><code>apiRoutes.js</code></td>
            <td>Returns aggregated metrics and counts</td>
            <td>REST JSON</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
